{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AnaRisk backend (API on :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "DATABASE_URL": "postgresql+psycopg://nimbus:nimbus_dev_pw@127.0.0.1:5432/nimbus",
        "AI_PROVIDER": "none",
        "ENVIRONMENT": "development"
      }
    },
    {
      "name": "AnaRisk backend — pytest suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "env": {
        "TEST_DATABASE_URL": "postgresql+psycopg://nimbus:nimbus_dev_pw@127.0.0.1:5432/nimbus_test"
      }
    }
  ]
}
