# ---- Copy to .env and edit. Never commit .env ----
ENVIRONMENT=development            # development | test | production
DEBUG=false

# PostgreSQL (docker-compose uses these same defaults)
# If local DNS resolution of 'localhost' is slow/broken, use 127.0.0.1 instead.
DATABASE_URL=postgresql+psycopg://nimbus:nimbus_dev_pw@127.0.0.1:5432/nimbus
TEST_DATABASE_URL=postgresql+psycopg://nimbus:nimbus_dev_pw@127.0.0.1:5432/nimbus_test

# ---- Supabase Auth (optional locally; when set, frontend Auth tokens are required) ----
# Project URL from Dashboard -> Connect (or Project Settings -> API Keys).
SUPABASE_URL=
# Publishable key (sb_publishable_...) from Project Settings -> API Keys. Public key only;
# never use the secret/service-role key here or in the browser.
SUPABASE_PUBLISHABLE_KEY=
# Server-only sb_secret_... key, required for admin-created user invitations. Never put in VITE_*.
SUPABASE_SECRET_KEY=
# Authenticated-user audience used by Supabase JWTs.
SUPABASE_JWT_AUDIENCE=authenticated

# JWT: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production the app REFUSES to start with the placeholder or a key shorter than 32 chars.
SECRET_KEY=change-me-in-production-this-is-only-a-development-placeholder
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list. "*" is rejected in production.
CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:3000,http://localhost:5173

# Legacy local-auth self-registration creates a brand_owner account. In Supabase mode the
# frontend signs up through Supabase Auth instead and backend role/scope provisioning applies.
ALLOW_PUBLIC_REGISTRATION=true

# Seed script bootstrap admin (used only by scripts/seed.py)
BOOTSTRAP_ADMIN_EMAIL=admin@nimbus.example
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-Admin-123

# Scoring (weights are normalised to sum to 1 at startup)
WEIGHT_BRAND_LOGO=0.30
WEIGHT_IMPERSONATION=0.30
WEIGHT_URL_RISK=0.25
WEIGHT_BEHAVIOR=0.15

# Outbound URL inspection is OFF by default. Enable only behind an egress firewall.
URL_FETCH_ENABLED=false
# Sum-of-observed-weights floor (0..1) below which an assessment is flagged "provisional" (thin evidence).
SCORING_COVERAGE_FLOOR=0.60

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_ENABLED=true

# ---- Transactional email (OTP signup verification + password reset) ----
# provider: none | smtp | resend   (memory is available for tests only)
# Setup for Resend / Gmail SMTP is documented in docs/EMAIL_SETUP.md.
#
# Signup verification uses a 6-digit OTP emailed to the address. With 'none' outside
# production, no email is sent and the API returns a dev-only `dev_otp` in the response
# so the flow can be completed without SMTP (never happens in production).
# With 'none' IN PRODUCTION, password-reset requests fail loudly (503) instead of
# pretending to send; OTP signup reports email_sent=false honestly.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com                  # e.g. email-smtp.us-east-1.amazonaws.com (Amazon SES), smtp.gmail.com, ...
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com               # the Gmail address that owns the app password
SMTP_PASSWORD=                            # 16-character Google app password (Account > Security > App passwords)
SMTP_STARTTLS=true
SMTP_USE_SSL=false          # true for port 465 style SMTPS
RESEND_API_KEY=             # re_xxxxxxxxxxxx - create at https://resend.com/api-keys; NEVER commit a real key
RESEND_API_BASE_URL=https://api.resend.com
EMAIL_FROM_ADDRESS=you@gmail.com          # must be a verified sender for the chosen provider
EMAIL_FROM_NAME=AnaRisk
FRONTEND_URL=http://127.0.0.1:3000    # links in emails point here (use https://yourdomain in production)
EMAIL_MAX_RETRIES=1

# ---- Email OTP hardening ----
OTP_TTL_MINUTES=10                # how long a signup code stays valid
OTP_MAX_ATTEMPTS=5                # wrong guesses per code before it is locked out
RESEND_VERIFICATION_COOLDOWN_SECONDS=60   # per-email throttle on resend (applies to unknown addresses too)

# ---- AI investigation assistant (optional) ----
# provider: none | openai-compatible (OpenAI, Azure OpenAI-compatible gateways, Ollama, vLLM, LiteLLM)
# NOTE: the value must be exactly "openai-compatible" - "openai" is invalid and the app
# will refuse to start. Without a provider the assistant answers from deterministic retrieval.
AI_PROVIDER=none
AI_API_KEY=                          # sk-... - NEVER commit a real key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1500

# ---- Background monitoring worker (DB-scheduled; safe to disable for a dedicated worker process) ----
MONITORING_WORKER_ENABLED=true
MONITORING_INTERVAL_SECONDS=300
MONITORING_RETRY_MAX=3
MONITORING_BACKOFF_SECONDS=120
