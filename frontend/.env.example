# Backend API base URL used by the built app.
#
# Leave unset to use the same-origin /api/v1 path (Vite dev server proxies /api to
# http://127.0.0.1:8000 — see vite.config.ts).
#
# For a separately deployed backend (Render, etc.) set the FULL base path at build time:
#   VITE_API_BASE_URL=https://your-api.onrender.com/api/v1
# An origin without a path (https://your-api.onrender.com) also works — /api/v1 is
# appended automatically.
#
# NEVER put backend secrets here: anything prefixed VITE_ is compiled into the public
# browser bundle. Secrets belong to the backend environment only.
VITE_API_BASE_URL=
