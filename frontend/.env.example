# Backend API base URL used by the built app.
#
# Leave unset for local development to use the same-origin /api/v1 path (Vite proxies
# the API to http://127.0.0.1:8000; see vite.config.ts).
# For a separately deployed backend, set its origin, for example:
#   VITE_API_BASE_URL=https://your-api.onrender.com
# The app appends /api/v1 when the origin has no path.
#
# Supabase Auth. Leave both blank to use the legacy local-development auth flow.
# In production set these from Supabase Project Settings -> API Keys. Use only the publishable
# key (sb_publishable_...), never a secret/service-role key.
VITE_SUPABASE_URL=https://pncodfwcicdlzhxxdxbv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_-3bcX9vJ2v_I-HolWFtHQw_irA7KGf3

# Anything prefixed VITE_ is compiled into the public browser bundle.
VITE_API_BASE_URL= https://nimbus-backend-19zs.onrender.com
